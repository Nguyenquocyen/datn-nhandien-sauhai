# MySQL/XAMPP connection. Replace the password if your root user has one.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/nhandien_sauhai_db?charset=utf8mb4

# Sao chép thành Code/.env và điền API key thật ở máy chạy backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Gmail SMTP (dùng App Password, không dùng mật khẩu Gmail chính)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
